class Deck:
    """Swipe state for one catalog: bag, pass, and the applied queue."""

    @staticmethod
    def load(path: str) -> Deck:
        """Load and validate a jobs JSON file."""
        ...
    @staticmethod
    def example() -> Deck:
        """Deck over the 12 embedded example jobs."""
        ...
    def swipe(self, job_id: str, decision: str, day: str | None = None) -> None:
        """Record a swipe.

        `decision` is `bag`, `like`, `apply`, `pass`, or `super`.
        `day` is `YYYY-MM-DD`. The default is today's UTC date.
        `super` is stored as a bag worth 25 xp. `pass` does not score.
        """
        ...
    def applied(self) -> list[Job]:
        """Bagged jobs, newest first."""
        ...
    def passed(self) -> list[Job]:
        """Passed jobs, oldest first."""
        ...
    def remaining(self) -> list[Job]:
        """Jobs not yet swiped, in catalog order."""
        ...
    def undo(self) -> str | None:
        """Drop the newest decision and return its id. Experience stays."""
        ...
    def reset(self) -> None:
        """Clear swipe history. Experience stays."""
        ...
    @property
    def xp(self) -> int:
        """Experience from bags (10) and super-bags (25)."""
        ...
    def __repr__(self) -> str: ...

